[Desktop Entry]
Type=Application
Name=AIO-Tool
Comment=AIO-Tool mit sichtbarer geprüfter Startroutine starten
Terminal=true
Categories=Utility;
Exec=bash -lc 'cd "$(dirname "$1")" && ./start_tool.sh; code=$?; if [ "$code" -ne 0 ]; then printf "\nStart fehlgeschlagen. Die Diagnose steht oben und in runtime/.\n"; read -r -p "Enter zum Schließen …" _; fi; exit "$code"' _ %k
Icon=applications-utilities
StartupNotify=true
