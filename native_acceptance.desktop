[Desktop Entry]
Type=Application
Name=AIO-Tool Native Abnahme
Comment=Geführte Kubuntu-, Browser-, Zoom- und Tastatur-Abnahme
Terminal=true
Categories=Utility;Development;
Exec=bash -lc 'cd "$(dirname "$1")" && ./start_native_acceptance.sh; code=$?; if [ "$code" -ne 0 ]; then read -r -p "Enter zum Schließen …" _; fi; exit "$code"' _ %k
Icon=checkbox
StartupNotify=true
